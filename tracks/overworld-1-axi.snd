
# Overworld theme 1, from AXI.
# Source: https://github.com/cfreder2/axi (web/sound.js)
#
# AXI stores this as MIDI arrays in a Music class, not as a score: LEAD as note
# numbers, CHORDS as triads, and ROOTS plus a WALK pattern the player combines
# at runtime. Transcribed here with the bass written out bar by bar. No notes
# were transposed or re-voiced.
#
# C major, 104 BPM, 8 bars, 4/4.

@track overworld-1-axi
  name   OVERWORLD 1 (AXI)
  bpm    104
  beats  16
  era    8bit
  tags   axi game original

@voice lead inst=lead-echo mix=0.19
  c5  .   d5  .   .   e5  .   .   g5  .   f5  .   e5  .   .   .
  d5  .   e5  .   .   g5  .   .   a5  .   .   .   g5  .   .   .
  e5  .   g5  .   .   a5  .   .   c6  .   .   b5  .   a5  .   .
  g5  .   .   .   e5  .   .   .   c5  .   .   .   d5  .   .   .
  a5  .   .   g5  .   .   f5  .   .   e5  .   .   d5  .   .   .
  e5  .   .   d5  .   .   c5  .   .   b4  .   .   a4  .   .   .
  a4  .   c5  .   .   d5  .   .   e5  .   .   g5  .   .   .   .
  f5  .   .   .   e5  .   .   .   d5  .   .   .   c5  .   .   .

@voice arp inst=arp mix=0.055
  c   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
  dm  .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
  c   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
  g   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
  am  .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
  c   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
  f   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
  g   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .

# Bass on eighths: root, root, octave, fifth. Generated at runtime in AXI.
@voice bass inst=tri mix=0.17
  c2  .   c2  .   c3  .   g2  .   c2  .   c3  .   g2  .   c2  .
  c2  .   c2  .   c3  .   g2  .   c2  .   c3  .   g2  .   c2  .
  f2  .   f2  .   f3  .   c3  .   f2  .   f3  .   c3  .   f2  .
  g2  .   g2  .   g3  .   d3  .   g2  .   g3  .   d3  .   g2  .
  f2  .   f2  .   f3  .   c3  .   f2  .   f3  .   c3  .   f2  .
  c2  .   c2  .   c3  .   g2  .   c2  .   c3  .   g2  .   c2  .
  d2  .   d2  .   d3  .   a2  .   d2  .   d3  .   a2  .   d2  .
  g2  .   g2  .   g3  .   d3  .   g2  .   g3  .   d3  .   g2  .

@voice drums inst=kit mix=0.105
  k   h   .   h   s   h   k   h   .   h   k   h   s   h   .   h
  k   h   .   h   s   h   k   h   .   h   k   h   s   h   .   h
  k   h   .   h   s   h   k   h   .   h   k   h   s   h   .   h
  k   h   .   h   s   h   k   h   .   h   k   h   x   x   t   x
  k   h   .   h   s   h   k   h   .   h   k   h   s   h   .   h
  k   h   .   h   s   h   k   h   .   h   k   h   s   h   .   h
  k   h   .   h   s   h   k   h   .   h   k   h   s   h   .   h
  k   h   .   h   s   h   k   h   .   h   k   h   x   x   t   x
