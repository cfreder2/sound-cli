
# Beethoven, Bagatelle in A minor, WoO 59 ("Fur Elise"). Public domain.
#
# The A section. Right hand in the lead voice, left-hand arpeggio in the bass.
# A minor, 68 BPM, 3/8. A bar here is two written measures: twelve sixteenths,
# six per measure. The gap in the middle of each line is the barline.

@track fur-elise
  name   FUR ELISE
  bpm    68
  beats  12
  era    16bit
  tags   classical beethoven public-domain

@voice lead inst=piano mix=0.19 pan=-0.06
  -   -   -   -   e5  d#5    e5  d#5 e5  b4  d5  c5
  a4  .   .   .   .   .      b4  .   .   .   .   .
  c5  .   .   -   e4  .      e5  d#5 e5  b4  d5  c5
  a4  .   .   .   .   .      b4  .   .   .   .   .
  c5  .   .   -   e4  .      c5  .   b4  .   a4  .

@voice bass inst=pluck mix=0.13 oct=-1 pan=0.08
  -   -   -   -   -   -      a3  .   e4  .   a4  .
  a3  .   e4  .   a4  .      e3  .   e4  .   g#4 .
  a3  .   e4  .   a4  .      a3  .   e4  .   a4  .
  a3  .   e4  .   a4  .      e3  .   e4  .   g#4 .
  a3  .   e4  .   a4  .      a3  .   e4  .   a4  .
