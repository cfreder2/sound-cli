
# Layers. A demonstration track.
#
# The same four bars played six times, adding one voice each pass:
#
#   bare    one 25% pulse
#   body    + the same line on a triangle an octave down
#   ground  + bass alternating root and octave
#   colour  + arpeggio
#   pulse   + drums
#   air     + a counter-line a sixth above the lead
#
# A minor, 116 BPM, 24 bars, 4/4.

@track layers
  name   LAYERS
  bpm    116
  beats  16
  era    8bit
  tags   demo teaching

@section bare
@voice lead inst=pulse25 mix=0.20
  a4  .   .   .   c5  .   .   .   e5  .   .   .   d5  .   .   .
  c5  .   .   .   a4  .   .   .   b4  .   .   .   .   .   .   .
  f4  .   .   .   a4  .   .   .   c5  .   .   .   b4  .   .   .
  a4  .   .   .   g4  .   .   .   a4  .   .   .   .   .   .   .

