# An incorrect answer. A minor second, held.

@fx wrong
  desc  An incorrect answer or invalid action
  tags  puzzle ui
@era 8bit
  tone   at=0 dur=0.30 gain=0.12 wave=pulse50 from=233 to=233 shape=flat
  tone   at=0 dur=0.30 gain=0.10 wave=pulse50 from=247 to=247 shape=flat
@era 16bit
  tone   at=0 dur=0.34 gain=0.11 wave=saw from=233 to=230 shape=exp pan=-0.2
  tone   at=0 dur=0.34 gain=0.09 wave=saw from=247 to=244 shape=exp pan=0.2
  tone   at=0 dur=0.38 gain=0.04 wave=sine from=116 to=114 shape=exp
